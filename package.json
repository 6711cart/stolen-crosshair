{
  "name": "stolen-crosshair",
  "version": "1.0.0",
  "description": "A customizable, click-through Windows crosshair overlay.",
  "main": "src/main.js",
  "author": "Stolen Crosshair",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start-app.js",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.stolencrosshair.app",
    "productName": "Stolen Crosshair",
    "publish": [],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron": true
  }
}
